{
  "id": "telegram",
  "label": "Telegram post",
  "icon": "send",
  "description": "Telegram channel post with markdown, emoji, optional cover image, and a CTA. Length-aware (capped to one screen).",
  "version": "5",
  "length_target_words": "17–58 (mean 46, p95 139 — rarely exceed 139)",
  "stages": [
    {
      "name": "plan",
      "capability": "plan"
    },
    {
      "name": "research",
      "capability": "research",
      "if_complexity_at_least": "standard"
    },
    {
      "name": "draft",
      "capability": "draft",
      "params": {
        "length_words": [
          17,
          58
        ],
        "hard_max_words": 139
      }
    },
    {
      "name": "critique",
      "capability": "critique"
    },
    {
      "name": "verify",
      "capability": "verify"
    },
    {
      "name": "voice-critic",
      "capability": "voice-critic"
    },
    {
      "name": "audit",
      "capability": "audit",
      "if_complexity_at_least": "deep"
    },
    {
      "name": "adapt",
      "capability": "adapt",
      "params": {
        "produce": [
          "body_md",
          "cta_text",
          "cta_url",
          "design_brief"
        ]
      }
    },
    {
      "name": "render",
      "renderer": "telegram"
    },
    {
      "name": "design",
      "capability": "design",
      "if_option": "with_image"
    },
    {
      "name": "image",
      "renderer": "image-cover",
      "if_option": "with_image"
    }
  ],
  "gateable_stages": [
    "critique",
    "verify",
    "voice-critic",
    "audit",
    "adapt",
    "design"
  ],
  "translate": {
    "capability": "translate",
    "stages_to_retranslate": [
      "body_md",
      "cta_text"
    ]
  },
  "options_schema": [
    {
      "key": "channel",
      "label": "Channel handle",
      "type": "text",
      "placeholder": "e.g. @rxapply_en"
    },
    {
      "key": "primary_cta",
      "label": "CTA URL",
      "type": "text",
      "placeholder": "https://rxapply.com"
    },
    {
      "key": "include_emoji",
      "label": "Include emoji",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "with_image",
      "label": "Generate cover image (~$0.04)",
      "type": "checkbox",
      "default": true
    }
  ]
}