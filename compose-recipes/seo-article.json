{
  "id": "seo-article",
  "label": "SEO article",
  "icon": "newspaper",
  "description": "Long-form article optimised for organic search: headline, slug, meta description, H1/H2 outline, full body in MDX/HTML, optional hero image.",
  "version": "3",

  "stages": [
    { "name": "plan",     "capability": "plan" },
    { "name": "research", "capability": "research", "params": { "depth": "deep" } },
    { "name": "draft",    "capability": "draft",    "params": { "length_words": [1200, 2000] } },
    { "name": "critique", "capability": "critique" },
    { "name": "verify",   "capability": "verify",   "if_option": "kb_verify" },
    { "name": "adapt",    "capability": "adapt",
      "params": { "produce": ["title", "slug", "meta_description", "outline", "body_md", "design_brief"] } },
    { "name": "render",   "renderer": "seo-article" },
    { "name": "design",   "capability": "design", "if_option": "with_image" },
    { "name": "image",    "renderer": "image-cover", "if_option": "with_image" }
  ],

  "gateable_stages": ["critique", "verify", "adapt", "design"],

  "translate": {
    "capability": "translate",
    "stages_to_retranslate": ["title", "meta_description", "body_md"]
  },

  "options_schema": [
    { "key": "target_keyword", "label": "Target keyword",     "type": "text", "placeholder": "e.g. NDEB Part 1 study guide" },
    { "key": "secondary_keywords", "label": "Secondary keywords (comma-separated)", "type": "text",
      "placeholder": "e.g. Canadian dental licensing, internationally trained dentists" },
    { "key": "internal_links",   "label": "Internal links (URL per line)", "type": "textarea",
      "placeholder": "https://rxapply.com/uk-licensing\nhttps://rxapply.com/about" },
    { "key": "kb_verify",        "label": "Daneshyar KB fact-check",        "type": "checkbox", "default": true },
    { "key": "with_image",       "label": "Generate hero image (~$0.04)",   "type": "checkbox", "default": false }
  ]
}
