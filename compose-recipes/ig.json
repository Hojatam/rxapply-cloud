{
  "id": "ig",
  "label": "Instagram",
  "icon": "instagram",
  "description": "Instagram feed post: caption + hashtags + cover image (the 'Afshin' visual brief is also stored for human designers).",
  "version": "3",

  "stages": [
    { "name": "plan",     "capability": "plan" },
    { "name": "research", "capability": "research" },
    { "name": "draft",    "capability": "draft", "params": { "length_words": [80, 220] } },
    { "name": "critique", "capability": "critique" },
    { "name": "adapt",    "capability": "adapt",
      "params": { "produce": ["caption", "hashtags", "design_plan", "design_brief"] } },
    { "name": "render",   "renderer": "ig" },
    { "name": "image",    "renderer": "image-cover", "if_option": "with_image" }
  ],

  "gateable_stages": ["critique", "adapt"],

  "translate": {
    "capability": "translate",
    "stages_to_retranslate": ["caption", "hashtags"]
  },

  "options_schema": [
    { "key": "primary_cta",     "label": "CTA URL (link in bio)", "type": "text", "placeholder": "https://rxapply.com" },
    { "key": "max_hashtags",    "label": "Max hashtags",          "type": "number", "default": 12, "min": 3, "max": 30 },
    { "key": "with_image",      "label": "Generate cover image (~$0.04)", "type": "checkbox", "default": true }
  ]
}
