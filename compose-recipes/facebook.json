{
  "id": "facebook",
  "label": "Facebook post",
  "icon": "facebook",
  "description": "Facebook page or group post: short hook, body, CTA, optional cover image.",
  "version": "3",

  "stages": [
    { "name": "plan",     "capability": "plan" },
    { "name": "draft",    "capability": "draft", "params": { "length_words": [80, 220] } },
    { "name": "critique", "capability": "critique" },
    { "name": "verify",   "capability": "verify", "if_option": "kb_verify" },
    { "name": "adapt",    "capability": "adapt",
      "params": { "produce": ["hook", "body", "cta_text", "design_brief"] } },
    { "name": "render",   "renderer": "facebook" },
    { "name": "design",   "capability": "design", "if_option": "with_image" },
    { "name": "image",    "renderer": "image-cover", "if_option": "with_image" }
  ],

  "gateable_stages": ["critique", "verify", "adapt", "design"],

  "translate": {
    "capability": "translate",
    "stages_to_retranslate": ["hook", "body", "cta_text"]
  },

  "options_schema": [
    { "key": "primary_cta", "label": "CTA URL",       "type": "text", "placeholder": "https://rxapply.com" },
    { "key": "page_handle", "label": "Page / Group",  "type": "text", "placeholder": "e.g. @RxApply" },
    { "key": "kb_verify",   "label": "Daneshyar KB fact-check",       "type": "checkbox", "default": true },
    { "key": "with_image",  "label": "Generate cover image (~$0.04)", "type": "checkbox", "default": true }
  ]
}
