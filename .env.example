# Copy this file to .env and fill in the values.
# .env is git-ignored; .env.example is committed.
#
# In production these are set in the Railway env-var dashboard.
# This file is for LOCAL DEV of the cloud build.

# ─── Database (Supabase Cloud or local Postgres) ─────────────────────
# Use the "Connection Pooling" URL from Supabase → Project Settings → Database.
# Format: postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Tools-framework symmetric key ───────────────────────────────────
# 32+ random bytes hex-encoded. Generate ONCE with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DO NOT regenerate — every connected tool's secrets become unreadable if you do.
SECRETS_KEY=

# ─── Cloudflare R2 (file storage) ────────────────────────────────────
# Get these from Cloudflare → R2 → Manage R2 API Tokens → Create.
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rxapply-prod
R2_PUBLIC_URL=                          # e.g. https://media.rxapply.com (custom R2 domain)

# ─── Cowork proxy ────────────────────────────────────────────────────
PORT=7777
NODE_ENV=development                    # 'production' on Railway

# ─── Optional: third-party tool keys ─────────────────────────────────
# These can also be entered through the dashboard's Tools tab; only set
# them as env vars if you want them pre-populated on first boot.
# TAVILY_API_KEY=
# PERPLEXITY_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
